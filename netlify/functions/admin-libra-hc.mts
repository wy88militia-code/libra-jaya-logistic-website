const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
const clean=(v:unknown,n=240)=>String(v??'').trim().slice(0,n);
const sameOrigin=(req:Request)=>{const u=new URL(req.url),o=req.headers.get('origin'),r=req.headers.get('referer');if(o)return o===u.origin;if(r){try{return new URL(r).origin===u.origin}catch{return false}}return false;};
const parseDate=(v:unknown)=>{const s=clean(v,40),m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m)return Date.UTC(+m[3],+m[2]-1,+m[1]);const t=Date.parse(s);return Number.isFinite(t)?t:0;};
const rows=(d:any)=>Array.isArray(d?.d)?d.d:[];
async function allCustomers(){const out:any[]=[];let p=1,pc=1;do{const {data}=await accurateGet('customer','list',{'sp.pageSize':100,'sp.page':p,fields:'id,no,name,suspended'});out.push(...rows(data));pc=Math.max(1,Math.min(Number(data?.sp?.pageCount)||1,100));p++;}while(p<=pc);return out;}
async function history(resource:string,c:any){for(const params of [{'sp.pageSize':20,'sp.page':1,'sp.sort':'transDate|desc',fields:'id,number,transDate,customerId,customerNo,totalAmount','filter.customerId':c.id},{'sp.pageSize':20,'sp.page':1,'sp.sort':'transDate|desc',fields:'id,number,transDate,customerId,customerNo,totalAmount','filter.customerNo':c.no}]){try{const {data}=await accurateGet(resource,'list',params);if(rows(data).length)return rows(data)[0]}catch{}}return null;}
async function testCustomer(name:string){const all=await allCustomers(),q=clean(name).toLowerCase(),matches=all.filter((c:any)=>clean(c.name).toLowerCase().includes(q)),out:any[]=[];for(const c of matches.slice(0,10)){const [si,so]=await Promise.all([history('sales-invoice',c),history('sales-order',c)]),activity=[si?.transDate,so?.transDate].filter(Boolean).sort((a:any,b:any)=>parseDate(b)-parseDate(a))[0]||null;out.push({id:c.id,no:c.no,name:c.name,suspended:Boolean(c.suspended),lastActivity:activity,lastInvoice:si?.number||null,lastOrder:so?.number||null});}out.sort((a,b)=>parseDate(b.lastActivity)-parseDate(a.lastActivity));return {matches:out,recommended:out.find(x=>!x.suspended)||null,totalCustomers:all.length};}

