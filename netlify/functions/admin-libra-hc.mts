import type { Config } from '@netlify/functions';
import { getAdminSession } from './_partner-core.mjs';
import { accurateGet } from './_accurate-core.mjs';

const HC_TAGIHAN='https://librahc.netlify.app/tagihan-manifest.html';
const ACCURATE='https://account.accurate.id/';
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
const clean=(v:unknown,n=240)=>String(v??'').trim().slice(0,n);
const money=(v:unknown)=>Math.max(0,Math.round(Number(v)||0));
const sameOrigin=(req:Request)=>{const u=new URL(req.url),o=req.headers.get('origin'),r=req.headers.get('referer');if(o)return o===u.origin;if(r){try{return new URL(r).origin===u.origin}catch{return false}}return false;};
const parseDate=(v:unknown)=>{const s=clean(v,40),m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m)return Date.UTC(+m[3],+m[2]-1,+m[1]);const t=Date.parse(s);return Number.isFinite(t)?t:0;};
const rows=(d:any)=>Array.isArray(d?.d)?d.d:[];
async function allCustomers(){const out:any[]=[];let p=1,pc=1;do{const {data}=await accurateGet('customer','list',{'sp.pageSize':100,'sp.page':p,fields:'id,no,name,suspended'});out.push(...rows(data));pc=Math.max(1,Math.min(Number(data?.sp?.pageCount)||1,100));p++;}while(p<=pc);return out;}
async function history(resource:string,c:any){for(const params of [{'sp.pageSize':20,'sp.page':1,'sp.sort':'transDate|desc',fields:'id,number,transDate,customerId,customerNo,totalAmount','filter.customerId':c.id},{'sp.pageSize':20,'sp.page':1,'sp.sort':'transDate|desc',fields:'id,number,transDate,customerId,customerNo,totalAmount','filter.customerNo':c.no}]){try{const {data}=await accurateGet(resource,'list',params);if(rows(data).length)return rows(data)[0]}catch{}}return null;}
async function testCustomer(name:string){const all=await allCustomers(),q=clean(name).toLowerCase(),matches=all.filter((c:any)=>clean(c.name).toLowerCase().includes(q)),out:any[]=[];for(const c of matches.slice(0,10)){const [si,so]=await Promise.all([history('sales-invoice',c),history('sales-order',c)]),activity=[si?.transDate,so?.transDate].filter(Boolean).sort((a:any,b:any)=>parseDate(b)-parseDate(a))[0]||null;out.push({id:c.id,no:c.no,name:c.name,suspended:Boolean(c.suspended),lastActivity:activity,lastInvoice:si?.number||null,lastOrder:so?.number||null});}out.sort((a,b)=>parseDate(b.lastActivity)-parseDate(a.lastActivity));return {matches:out,recommended:out.find(x=>!x.suspended)||null,totalCustomers:all.length};}
function herlyPreview(){const goods=[['Semir Hitop',1,8],['Home Snow',3,33],['Vocaris Merah+Vocaris Hijau',2,57],['Vocaris Kemiri',1,32],['Vocaris Orang-Aring',1,34],['Vocaris Kemiri Besar',1,34]],rate=10300;const lines=goods.map(([name,koli,kg])=>({itemNo:'100001',name:`Jasa Kargo Udara HC - Ibu Herly - ${name}`,koli,kg,rate,total:money(Number(kg)*rate),department:'Kargo HC Sentani'}));lines.push({itemNo:'100020',name:'Asuransi+Admin WMA - Ibu Herly',koli:'-',kg:1,rate:99400,total:99400,department:'Kargo HC Sentani'});const total=lines.reduce((s,x)=>s+x.total,0);if(total!==2138800)throw new Error('Preview Herly gagal kontrol total.');return {customerNo:'C.00024',customerName:'Ibu Herly',lines,total,cargo:2039400,insurance:99400,handling:0,kg:198,koli:9};}

export default async(req:Request)=>{const session=getAdminSession(req);if(!session)return Response.redirect(new URL('/libra-admin-login.html',req.url),302);let result:any=null,preview:any=null,error='';if(req.method==='POST'){try{if(!sameOrigin(req))throw new Error('Origin form tidak valid.');if(String(session.role||'').toUpperCase()!=='SUPERADMIN')throw new Error('Hanya SUPERADMIN.');const f=await req.formData(),action=String(f.get('action'));if(action==='test_customer')result=await testCustomer(clean(f.get('name'))||'Herly');else if(action==='preview_herly')preview=herlyPreview();else throw new Error('Aksi tidak valid.');}catch(e:any){error=clean(e?.message||e,800);}}else if(req.method!=='GET')return new Response('Method Not Allowed',{status:405});
const testHtml=result?`<div class="testbox"><h3>Hasil Test Accurate — READ ONLY</h3><p>Dibaca ${result.totalCustomers} customer. Tidak ada transaksi yang dibuat.</p>${result.matches.length?`<table><thead><tr><th>Customer</th><th>Status</th><th>Aktivitas terakhir</th><th>Faktur terakhir</th></tr></thead><tbody>${result.matches.map((x:any)=>`<tr class="${result.recommended?.id===x.id?'pick':''}"><td><b>${esc(x.name)}</b><small>${esc(x.no)} • ID ${esc(x.id)}</small></td><td>${x.suspended?'NONAKTIF':'AKTIF'}${result.recommended?.id===x.id?' • DIPILIH':''}</td><td>${esc(x.lastActivity||'-')}</td><td>${esc(x.lastInvoice||'-')}</td></tr>`).join('')}</tbody></table>`:`<p>Tidak ada customer yang cocok.</p>`}</div>`:'';
const previewHtml=preview?`<div class="testbox"><h3>Preview Faktur Herly — BELUM POST</h3><p><b>${esc(preview.customerNo)} • ${esc(preview.customerName)}</b> — ${preview.koli} koli • ${preview.kg} kg</p><table><thead><tr><th>Item</th><th>Nama detail</th><th>Qty</th><th>Harga</th><th>Total</th></tr></thead><tbody>${preview.lines.map((x:any)=>`<tr><td>[${esc(x.itemNo)}]</td><td>${esc(x.name)}<small>${esc(x.department)}${x.koli!=='-'?' • '+esc(x.koli)+' koli':''}</small></td><td>${esc(x.kg)}</td><td>Rp${x.rate.toLocaleString('id-ID')}</td><td>Rp${x.total.toLocaleString('id-ID')}</td></tr>`).join('')}</tbody></table><div class="notice"><b>VALID:</b> Ongkir Rp${preview.cargo.toLocaleString('id-ID')} + Asuransi/Admin Rp${preview.insurance.toLocaleString('id-ID')} + Handling Rp0 = <b>Rp${preview.total.toLocaleString('id-ID')}</b>. 7 baris. Tidak ada Sales Order dan belum ada transaksi Accurate yang dibuat.</div></div>`:'';
return new Response(`<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Libra HC — Faktur Accurate</title><style>*{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:#f2f6fa;color:#10243d}.top{background:#061d36;color:#fff;padding:20px}.topin,.wrap{max-width:1040px;margin:auto}.topin{display:flex;justify-content:space-between}.top a{color:#fff}.wrap{padding:26px 16px}.hero{background:#0b2d52;color:#fff;border-radius:20px;padding:26px;margin-bottom:16px}.hero h1{margin:5px 0}.grid{display:grid;grid-template-columns:1.3fr .7fr;gap:16px}.card,.testbox{background:#fff;border:1px solid #dbe5ee;border-radius:17px;padding:20px;margin-bottom:16px}.notice{background:#eef7f1;border:1px solid #cfe6d6;color:#17633b;border-radius:12px;padding:13px;margin:14px 0}.notice.bad{background:#ffebe9;color:#a52d25}.btn,button{display:inline-block;text-decoration:none;border:0;border-radius:10px;padding:12px 15px;font-weight:800;background:#0b2d52;color:#fff;cursor:pointer;margin:4px}.secondary{background:#fff;color:#0b2d52;border:1px solid #b8cad9}.testbox{overflow:auto}.testbox table{width:100%;border-collapse:collapse;min-width:700px}.testbox th,.testbox td{text-align:left;padding:10px;border-bottom:1px solid #e6edf3;font-size:12px}.testbox small{display:block;color:#708397}.pick{background:#e9f7ef}@media(max-width:720px){.grid{grid-template-columns:1fr}}</style></head><body><header class="top"><div class="topin"><strong>LIBRA JAYA LOGISTIC • SUPER ADMIN</strong><a href="/admin-tool">← Home</a></div></header><main class="wrap"><section class="hero"><small>FORMAT FINAL TERKUNCI</small><h1>Libra Tools HC → Faktur Penjualan Accurate</h1><div>Langsung Faktur Penjualan. Tidak melalui Sales Order.</div></section>${error?`<div class="notice bad">${esc(error)}</div>`:''}<div class="grid"><section class="card"><h2>Kontrol sebelum posting</h2><p>[100001] per jenis barang • [100020] Asuransi+Admin • [100014] Handling hanya bila &gt;0 • Departemen Kargo HC Sentani.</p><form method="post"><input type="hidden" name="action" value="preview_herly"><button>Preview Faktur Herly</button></form><form method="post"><input type="hidden" name="action" value="test_customer"><input name="name" value="Herly"><button>Test Customer Accurate</button></form></section><aside class="card"><h2>Alur</h2><p>Tagihan HC → validasi customer & total → Faktur Penjualan Accurate → pembayaran/pelunasan hanya di Accurate.</p><a class="btn secondary" href="${HC_TAGIHAN}">Buka Tagihan HC</a><a class="btn secondary" href="${ACCURATE}" target="_blank" rel="noopener">Buka Accurate</a></aside></div>${previewHtml}${testHtml}</main></body></html>`,{headers:{'content-type':'text/html; charset=utf-8','cache-control':'no-store','x-frame-options':'DENY','content-security-policy':"default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"}});};
export const config:Config={path:'/admin-libra-hc'};
