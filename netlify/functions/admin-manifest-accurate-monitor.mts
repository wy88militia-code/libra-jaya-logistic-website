import type { Config } from '@netlify/functions';
import { listAccurateJobs, testAccurateConnection } from './_accurate-core.mjs';
import { syncManifestToAccurateSalesOrders } from './_manifest-accurate-so-core.mjs';
import { listManifests } from './_manifest-core.mjs';
import { getAdminSession } from './_partner-core.mjs';

const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
const fmt=(v:unknown)=>Number(v||0).toLocaleString('id-ID',{maximumFractionDigits:2});
const when=(v:unknown)=>{const s=String(v||'').trim();if(!s)return '-';const d=new Date(s);return Number.isNaN(d.getTime())?s:new Intl.DateTimeFormat('id-ID',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Jayapura'}).format(d)+' WIT';};
const sameOrigin=(req:Request)=>{const u=new URL(req.url),origin=req.headers.get('origin'),ref=req.headers.get('referer');if(origin)return origin===u.origin;if(ref){try{return new URL(ref).origin===u.origin}catch{return false}}return false;};

function jobManifestId(job:any){return String(job?.manifestId||job?.sourceId||job?.metadata?.manifestId||job?.payload?.manifestId||job?.journalDraft?.manifestId||job?.salesOrderDraft?.manifestId||'').trim();}
function jobMentionsManifest(job:any,manifestId:string){if(!manifestId)return false;if(jobManifestId(job)===manifestId)return true;const hay=[job?.jobId,job?.statementNo,job?.journalNumber,job?.accurateReference,job?.description,job?.lastError,job?.metadata?.description,job?.payload?.description,job?.journalDraft?.description,job?.salesOrderDraft?.description,job?.salesOrderDraft?.poNumber].filter(Boolean).join(' ').toUpperCase();return hay.includes(manifestId.toUpperCase());}
const successStatuses=new Set(['POSTED','VERIFIED','SUCCESS','SYNCED','COMPLETED']);
const failedStatuses=new Set(['POST_FAILED','FAILED','ERROR','RECONCILE_REQUIRED','NEEDS_MAPPING','BLOCKED']);
function aggregateState(jobs:any[]){if(!jobs.length)return {key:'NOT_SENT',label:'BELUM DIKIRIM',kind:'idle'};const statuses=jobs.map(j=>String(j.status||'').toUpperCase());if(statuses.some(s=>failedStatuses.has(s)))return {key:'FAILED',label:'GAGAL / REVIEW',kind:'bad'};if(statuses.some(s=>!successStatuses.has(s)))return {key:'PENDING',label:'MENUNGGU',kind:'wait'};return {key:'SUCCESS',label:'SUKSES',kind:'ok'};}

export default async(req:Request)=>{
 const session=getAdminSession(req);if(!session)return Response.redirect(new URL('/libra-admin-login.html',req.url),302);
 const url=new URL(req.url);const filter=String(url.searchParams.get('status')||'ALL').toUpperCase(),q=String(url.searchParams.get('q')||'').trim().toLowerCase();let message='',actionError='';
 if(req.method==='POST'){
   try{if(!sameOrigin(req))throw new Error('Origin form tidak valid.');if(String(session.role||'').toUpperCase()!=='SUPERADMIN')throw new Error('Hanya SUPERADMIN yang dapat mengirim Pesanan Penjualan ke Accurate.');const f=await req.formData();if(String(f.get('action')||'')!=='sync_manifest_so')throw new Error('Aksi tidak valid.');const manifestId=String(f.get('manifestId')||'').trim();const result=await syncManifestToAccurateSalesOrders({manifestId,session,request:req});message=`${manifestId}: ${result.success}/${result.total} Pesanan Penjualan sukses masuk Accurate${result.failed?` • ${result.failed} perlu review`:''}.`;}
   catch(e:any){actionError=String(e?.message||e||'Sinkronisasi Accurate gagal.');}
 }else if(req.method!=='GET')return new Response('Method not allowed',{status:405});
 let connection:any=null,connectionError='';try{connection=await testAccurateConnection();}catch(e:any){connectionError=String(e?.message||e||'Koneksi Accurate gagal');}
 const [manifests,jobs]=await Promise.all([listManifests(300),listAccurateJobs(1000)]);
 const rows=manifests.map((m:any)=>{const related=jobs.filter((j:any)=>jobMentionsManifest(j,m.manifestId)).sort((a:any,b:any)=>String(b.updatedAt||b.createdAt||'').localeCompare(String(a.updatedAt||a.createdAt||'')));const state=aggregateState(related),ok=related.filter((j:any)=>successStatuses.has(String(j.status||'').toUpperCase())).length,failed=related.filter((j:any)=>failedStatuses.has(String(j.status||'').toUpperCase())).length,pending=Math.max(0,related.length-ok-failed);return {manifest:m,jobs:related,state,ok,failed,pending};});
 const counts=rows.reduce((a:any,r:any)=>{a[r.state.key]=(a[r.state.key]||0)+1;return a;},{SUCCESS:0,FAILED:0,PENDING:0,NOT_SENT:0});
 const visible=rows.filter((r:any)=>{if(filter!=='ALL'&&r.state.key!==filter)return false;if(!q)return true;const m=r.manifest;return [m.manifestId,m.origin,m.destination,m.carrier,m.serviceNumber,...r.jobs.flatMap((j:any)=>[j.jobId,j.accurateReference,j.salesOrderNumber,j.status,j.bookingId])].filter(Boolean).join(' ').toLowerCase().includes(q);});
 const tabs=[['ALL','Semua',rows.length],['SUCCESS','Sukses',counts.SUCCESS],['FAILED','Gagal',counts.FAILED],['PENDING','Menunggu',counts.PENDING],['NOT_SENT','Belum Dikirim',counts.NOT_SENT]].map(([k,l,n])=>`<a class="tab ${filter===k?'active':''}" href="?status=${k}${q?`&q=${encodeURIComponent(q)}`:''}">${l} <b>${n}</b></a>`).join('');
 const canSync=String(session.role||'').toUpperCase()==='SUPERADMIN';
 const body=visible.map((r:any)=>{const m=r.manifest,refs=r.jobs.map((j:any)=>j.accurateReference||j.salesOrderNumber).filter(Boolean),errors=r.jobs.map((j:any)=>j.lastError).filter(Boolean),eligible=['CLOSED','DEPARTED','ARRIVED','COMPLETED'].includes(String(m.status||'').toUpperCase()),syncButton=canSync&&eligible?`<form method="post" class="syncform"><input type="hidden" name="action" value="sync_manifest_so"><input type="hidden" name="manifestId" value="${esc(m.manifestId)}"><button ${connection?.ok?'':'disabled'}>${r.jobs.length?'↻ Sinkron Ulang Aman':'→ Kirim ke Accurate'}</button></form>`:'<small>Manifest harus CLOSED</small>',jobSummary=r.jobs.length?`${r.ok} sukses • ${r.failed} gagal/review • ${r.pending} proses`:'Tidak ada job Accurate';return `<tr><td><strong>${esc(m.manifestId)}</strong><small>${esc(m.mode)} • ${esc(m.status)}</small>${syncButton}</td><td>${esc(m.origin)} → ${esc(m.destination)}<small>${esc(m.carrier||'-')} ${esc(m.serviceNumber||'')}</small></td><td class="num">${fmt(m.summary?.bookingCount)}<small>${fmt(m.summary?.actualWeightKg)} kg</small></td><td><span class="badge ${r.state.kind}">${esc(r.state.label)}</span><small>${esc(jobSummary)}</small></td><td>${refs.length?refs.slice(0,3).map((x:any)=>`<strong>${esc(x)}</strong>`).join('<br>'):'-'}${refs.length>3?`<small>+${refs.length-3} referensi lain</small>`:''}</td><td>${esc(when(r.jobs[0]?.postedAt||r.jobs[0]?.updatedAt||r.jobs[0]?.createdAt||m.updatedAt))}</td><td class="error">${errors.length?esc(errors.slice(0,2).join(' | ')):'-'}</td></tr>`;}).join('')||`<tr><td colspan="7" class="empty">Tidak ada data untuk filter ini.</td></tr>`;
 const connectionClass=connection?.ok?'conn-ok':'conn-bad',dbName=connection?.database?.alias||connection?.database?.name||connection?.database?.databaseName||'Accurate Online',authMode=connection?.mode||'-',accountProbe=connection?.accountProbe?.name||connection?.accountProbe?.no||(connection?.accountProbe?.error?'Probe gagal':'OK'),connectionText=connection?.ok?`API TERHUBUNG • ${dbName}`:`API GAGAL • ${connectionError||'Tidak terhubung'}`,connectionDetail=connection?.ok?`Mode ${authMode} • Database ${dbName} • Probe akun ${accountProbe} • Dicek ${when(connection?.testedAt)}`:`Koneksi API Accurate gagal. ${connectionError||'Periksa token, secret, database, dan jaringan.'}`;
 return new Response(`<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta http-equiv="refresh" content="30"><title>Monitor Manifest → Accurate</title><style>*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:#f3f6f9;color:#10243d}.top{background:#061d36;color:#fff;padding:20px}.topin,.wrap{max-width:1280px;margin:auto}.topin{display:flex;justify-content:space-between;gap:14px;align-items:center}.top a{color:#fff;text-decoration:none;border:1px solid #58718b;border-radius:9px;padding:8px 12px}.wrap{padding:24px 16px 48px}.hero{display:flex;justify-content:space-between;gap:18px;align-items:flex-end;background:#fff;border:1px solid #dbe5ee;border-radius:18px;padding:22px;margin-bottom:14px}.hero h1{margin:0 0 6px;font-size:28px}.hero p{margin:0;color:#63768a}.conn{padding:10px 13px;border-radius:11px;font-weight:900;font-size:12px;max-width:460px}.conn small{display:block;margin-top:5px;font-weight:700;line-height:1.35;opacity:.9}.conn-ok{background:#e7f6ed;color:#16723b}.conn-bad{background:#ffebe9;color:#a52d25}.notice{padding:12px 14px;border-radius:11px;margin:0 0 12px;background:#e7f6ed;color:#16723b;font-weight:750}.notice.bad{background:#ffebe9;color:#a52d25}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:14px 0}.stat{background:#fff;border:1px solid #dbe5ee;border-radius:15px;padding:16px}.stat b{display:block;font-size:27px}.stat span{color:#64778a;font-size:12px;font-weight:800}.oktxt{color:#16723b}.badtxt{color:#b23028}.waittxt{color:#a56c00}.idletxt{color:#68798a}.tools{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin:16px 0}.tabs{display:flex;gap:8px;flex-wrap:wrap}.tab{text-decoration:none;background:#e9eff5;color:#28445f;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:800}.tab.active{background:#0b2d52;color:#fff}.tab b{margin-left:4px}.search{display:flex;gap:7px}.search input{border:1px solid #cbd8e4;border-radius:9px;padding:9px 10px;min-width:220px}.search button,.syncform button{border:0;background:#0b2d52;color:#fff;border-radius:9px;padding:9px 12px;font-weight:800}.syncform{margin-top:8px}.syncform button{font-size:11px;background:#11623b}.syncform button:disabled{background:#9aa7b3}.tablewrap{background:#fff;border:1px solid #dbe5ee;border-radius:16px;overflow:auto}table{border-collapse:collapse;width:100%;min-width:1150px}th,td{padding:13px 12px;border-bottom:1px solid #e8eef4;text-align:left;vertical-align:top;font-size:13px}th{background:#f7f9fb;font-size:11px;color:#617486}td small{display:block;color:#718398;margin-top:4px}.num{text-align:right}.badge{display:inline-block;padding:6px 9px;border-radius:999px;font-size:10px;font-weight:900}.badge.ok{background:#e7f6ed;color:#16723b}.badge.bad{background:#ffebe9;color:#a52d25}.badge.wait{background:#fff4cf;color:#835d08}.badge.idle{background:#edf1f5;color:#657688}.error{max-width:310px;color:#9b332d}.empty{text-align:center;padding:34px;color:#718398}.note{margin-top:14px;background:#eef5fb;border:1px solid #d4e4f1;border-radius:13px;padding:13px;color:#456078;font-size:12px;line-height:1.5}@media(max-width:760px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{align-items:flex-start;flex-direction:column}.search{width:100%}.search input{min-width:0;flex:1}}</style></head><body><header class="top"><div class="topin"><div><strong>LIBRA JAYA LOGISTIC</strong><div style="font-size:12px;color:#bfd0df;margin-top:3px">Libra Tools • Monitor Manifest → Accurate</div></div><a href="/admin-tool">← Libra Tools</a></div></header><main class="wrap"><section class="hero"><div><h1>Monitor Manifest → Accurate</h1><p>End-to-end: manifest CLOSED → Pesanan Penjualan per booking → duplicate guard → POST Accurate → read-back verification → status monitor.</p></div><div class="conn ${connectionClass}">${esc(connectionText)}<small>${esc(connectionDetail)}</small></div></section>${message?`<div class="notice">${esc(message)}</div>`:''}${actionError?`<div class="notice bad">${esc(actionError)}</div>`:''}<section class="stats"><div class="stat"><b class="oktxt">${counts.SUCCESS}</b><span>SUKSES</span></div><div class="stat"><b class="badtxt">${counts.FAILED}</b><span>GAGAL / REVIEW</span></div><div class="stat"><b class="waittxt">${counts.PENDING}</b><span>MENUNGGU</span></div><div class="stat"><b class="idletxt">${counts.NOT_SENT}</b><span>BELUM DIKIRIM</span></div></section><div class="tools"><div class="tabs">${tabs}</div><form class="search" method="get"><input type="hidden" name="status" value="${esc(filter)}"><input name="q" value="${esc(q)}" placeholder="Cari manifest / booking / ref Accurate"><button>Cari</button></form></div><div class="tablewrap"><table><thead><tr><th>Manifest / Aksi</th><th>Rute</th><th>Booking / Berat</th><th>Status Accurate</th><th>Referensi SO Accurate</th><th>Update Terakhir</th><th>Error</th></tr></thead><tbody>${body}</tbody></table></div><div class="note"><strong>Alur aman:</strong> setiap booking pada manifest dibuat sebagai satu Pesanan Penjualan Accurate. Sistem memakai billing draft/final price yang sudah ada, mapping customer + item Accurate, nomor SO deterministik, pengecekan duplikat, lalu read-back. Jika hasil POST tidak pasti, status menjadi RECONCILE_REQUIRED dan tidak diulang buta. <br><strong>API:</strong> indikator kanan atas dites langsung setiap halaman dimuat. Tombol posting hanya tersedia untuk SUPERADMIN dan manifest CLOSED atau lebih lanjut. Refresh otomatis tiap 30 detik.</div></main></body></html>`,{headers:{'content-type':'text/html; charset=utf-8','cache-control':'no-store','x-frame-options':'DENY','content-security-policy':"default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"}});
